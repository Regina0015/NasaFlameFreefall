{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hallazgo.schema.json",
  "title": "Hallazgo",
  "description": "Una afirmación con su cálculo y su evidencia. Lo produce la etapa 04.",
  "type": "object",
  "required": ["id", "pregunta", "afirmacion", "tipo", "estado", "calculo", "evidencia", "n_pruebas", "supuestos", "limites", "generado_por"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^H-[0-9]{3}$" },
    "pregunta": { "type": "string", "description": "La pregunta de la etapa 03 que responde" },
    "afirmacion": { "type": "string", "description": "El hallazgo en una frase, sin adornos" },
    "tipo": { "enum": ["cobertura", "limite", "comparacion", "tendencia", "ranking", "hueco"] },
    "estado": { "enum": ["con_datos", "sin_datos"] },
    "valores": {
      "type": "object",
      "description": "Resultados numéricos: nombre → valor y unidad",
      "additionalProperties": {
        "type": "object",
        "required": ["valor", "unidad"],
        "properties": {
          "valor": { "type": ["number", "null"] },
          "unidad": { "type": "string" }
        }
      }
    },
    "calculo": {
      "type": "object",
      "required": ["script", "funcion", "parametros"],
      "properties": {
        "script": { "type": "string", "description": "Ruta del script, por ejemplo scripts/calculos.py" },
        "funcion": { "type": "string" },
        "parametros": { "type": "object" },
        "formula": { "type": "string", "description": "La fórmula o regla en palabras" }
      }
    },
    "evidencia": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["investigacion", "doi", "tabla", "filas"],
        "properties": {
          "investigacion": { "type": "string", "pattern": "^PSI-[0-9]+$" },
          "doi": { "type": "string" },
          "tabla": { "type": "string" },
          "columnas": { "type": "array", "items": { "type": "string" } },
          "filas": {
            "description": "Filas del CSV original que se usaron, o \"todas\"",
            "oneOf": [
              { "type": "array", "items": { "type": "integer", "minimum": 1 } },
              { "const": "todas" }
            ]
          }
        }
      }
    },
    "n_pruebas": { "type": "integer", "minimum": 0 },
    "supuestos": { "type": "array", "items": { "type": "string" } },
    "limites": { "type": "array", "items": { "type": "string" }, "description": "Lo que el hallazgo NO permite concluir" },
    "habitats": { "type": "array", "items": { "enum": ["nave", "estacion", "base_lunar", "base_marciana", "rover"] } },
    "pilar": { "enum": ["prevencion", "deteccion", "supresion", null] },
    "generado_por": {
      "type": "object",
      "required": ["agente", "modelo", "fecha"],
      "properties": {
        "agente": { "type": "string" },
        "modelo": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" }
      }
    }
  }
}
