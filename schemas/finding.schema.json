{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "description": "One answer from the Calculator agent. Human-readable spec: docs/calculator-output.md.",
  "type": "object",
  "required": [
    "id", "version", "question", "status", "claim", "summary_student", "summary_professional",
    "values", "method", "evidence", "n_tests", "assumptions", "limitations", "warnings",
    "environments", "tier", "pillar", "visual_offer", "chart", "graph", "generated_by"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
    "version": { "type": "integer", "minimum": 1 },
    "question": { "type": "string", "minLength": 1 },
    "status": { "enum": ["has_data", "no_data"] },
    "claim": { "type": "string", "minLength": 1 },
    "summary_student": { "type": "string", "minLength": 1 },
    "summary_professional": { "type": "string", "minLength": 1 },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "unit"],
        "additionalProperties": false,
        "properties": {
          "value": { "type": ["number", "null"] },
          "unit": { "type": "string" }
        }
      }
    },
    "method": {
      "type": "object",
      "required": ["script", "function", "params", "formula"],
      "additionalProperties": false,
      "properties": {
        "script": { "type": "string" },
        "function": { "type": "string" },
        "params": { "type": "object" },
        "formula": { "type": "string" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["investigation", "doi", "table", "columns", "rows"],
        "additionalProperties": false,
        "properties": {
          "investigation": { "type": "string", "pattern": "^PSI-[0-9]+$" },
          "doi": { "type": "string" },
          "table": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rows": {
            "oneOf": [
              { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
              { "const": "all" }
            ]
          }
        }
      }
    },
    "n_tests": { "type": "integer", "minimum": 0 },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "environments": {
      "type": "array",
      "items": { "enum": ["transit_vehicle", "space_station", "lunar_base", "mars_base", "pressurized_rover"] },
      "uniqueItems": true
    },
    "tier": { "enum": [1, 2, null] },
    "pillar": { "enum": ["prevention", "detection", "suppression", null] },
    "visual_offer": {
      "type": "object",
      "required": ["chart", "graph", "footnote"],
      "additionalProperties": false,
      "properties": {
        "chart": { "$ref": "#/$defs/offer" },
        "graph": { "$ref": "#/$defs/offer" },
        "footnote": { "type": ["string", "null"] }
      }
    },
    "chart": {
      "description": "Vega-Lite specification with inline data, or null until requested.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["title", "data"],
          "properties": {
            "title": { "type": "string" },
            "data": {
              "type": "object",
              "required": ["values"],
              "properties": { "values": { "type": "array", "minItems": 1 } }
            }
          }
        }
      ]
    },
    "graph": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["nodes", "edges"],
          "additionalProperties": false,
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string" },
                  "type": { "enum": ["finding", "method", "investigation", "table", "publication", "hardware"] },
                  "label": { "type": "string" }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to", "type", "source"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "type": { "enum": ["computed_with", "uses_data_from", "related_in_psi", "same_hardware", "same_fuel", "reuses_flight_data"] },
                  "source": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "generated_by": {
      "type": "object",
      "required": ["agent", "model", "date"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "model": { "type": "string" },
        "date": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "offer": {
      "type": "object",
      "required": ["available", "idea"],
      "additionalProperties": false,
      "properties": {
        "available": { "type": "boolean" },
        "idea": { "type": ["string", "null"] }
      }
    }
  }
}
