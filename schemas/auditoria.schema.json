{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "auditoria.schema.json",
  "title": "Auditoría",
  "description": "Resultado de revisar un hallazgo. Lo produce la etapa 05. Reglas en _config/confianza.md.",
  "type": "object",
  "required": ["hallazgo_id", "comprobaciones", "grado", "motivos", "auditado_por"],
  "additionalProperties": false,
  "properties": {
    "hallazgo_id": { "type": "string", "pattern": "^H-[0-9]{3}$" },
    "comprobaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nombre", "hecha_por", "resultado"],
        "properties": {
          "id": { "enum": ["C1", "C2", "C3", "C4", "C5", "C6", "C7", "C8"] },
          "nombre": { "type": "string" },
          "hecha_por": { "enum": ["codigo", "modelo"] },
          "resultado": { "enum": ["pasa", "falla", "no_aplica"] },
          "detalle": { "type": "string", "description": "Qué se comparó y qué salió" }
        }
      }
    },
    "recalculo": {
      "type": "object",
      "description": "Valores obtenidos por el segundo cálculo, para compararlos con los del hallazgo",
      "additionalProperties": { "type": ["number", "null"] }
    },
    "grado": { "enum": ["A", "B", "C", "sin_datos", "rechazado"] },
    "motivos": { "type": "array", "items": { "type": "string" }, "description": "Por qué ese grado, en frases cortas" },
    "auditado_por": {
      "type": "object",
      "required": ["script", "modelo", "fecha"],
      "properties": {
        "script": { "type": "string" },
        "modelo": { "type": ["string", "null"], "description": "Modelo que hizo C8; null si no se usó" },
        "fecha": { "type": "string", "format": "date-time" }
      }
    }
  }
}
