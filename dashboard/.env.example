# Copy to .env.local and fill in these public browser settings.
# Never put the Supabase service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local chat settings, read by the Vite server.
# Keep these without a VITE_ prefix.
# Model configuration: _config/models.md.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=gemma4:e4b-it-qat
# To use the model on the Auditor PC through its gateway instead (api/routes/llm.py):
#   OLLAMA_URL=http://<gateway IP>:8000/llm
#   OLLAMA_API_KEY=<the gateway's API_KEY, the same value as AUDITOR_API_KEY in the root .env>
OLLAMA_API_KEY=

# Optional local demo accounts.
# Checked in the browser only; these do not provide real security.
# Leave empty to disable.
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
VITE_DEMO_PRO_EMAIL=
VITE_DEMO_PRO_PASSWORD=