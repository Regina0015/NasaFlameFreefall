# Copiar a .env.local y llenar. Estas dos claves son públicas (van en el navegador).
# Nunca poner aquí la clave "service_role" de Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local demo accounts for the login page (student and professional).
# Checked in the browser only, so they are not real security. Leave empty to turn them off.
VITE_DEMO_STUDENT_EMAIL=
VITE_DEMO_STUDENT_PASSWORD=
VITE_DEMO_PRO_EMAIL=
VITE_DEMO_PRO_PASSWORD=
