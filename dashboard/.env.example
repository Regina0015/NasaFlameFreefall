# Copiar a .env.local y llenar. Estas dos claves son públicas (van en el navegador).
# Nunca poner aquí la clave "service_role" de Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local chat (read only by the Vite server, never sent to the browser: no VITE_ prefix).
# Without these lines the values below are used. Model and parameters: _config/models.md.
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=gemma4:e4b-it-qat
