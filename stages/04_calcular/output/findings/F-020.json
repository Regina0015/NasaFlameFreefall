  "method": {
    "script": "scripts/functions.py",
    "function": "sql_query",
    "params": {
      "sql": "WITH g AS (SELECT investigation, source_table, min(flow_cm_s) AS lo, max(flow_cm_s) AS hi, list(source_row ORDER BY source_row) AS source_rows, list(DISTINCT json_extract_string(field_sources, '$.flow_cm_s')) AS source_columns FROM tests WHERE flow_cm_s IS NOT NULL AND scope = 'psi' GROUP BY investigation, source_table HAVING max(flow_cm_s) > min(flow_cm_s)) SELECT lower(replace(investigation, '-', '')) || '_flow_range_width' AS name, hi - lo AS value, 'cm/s' AS unit, investigation, source_table, source_rows, source_columns FROM g UNION ALL SELECT lower(replace(investigation, '-', '')) || '_flow_min', lo, 'cm/s', investigation, source_table, source_rows, source_columns FROM g UNION ALL SELECT lower(replace(investigation, '-', '')) || '_flow_max', hi, 'cm/s', investigation, source_table, source_rows, source_columns FROM g"
    },
    "formula": "The values returned by the SQL query in params, one row per value, each with the source rows it used."
