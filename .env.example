# Copy to .env and fill in. .env is never committed.
# SUPABASE_*: needed by scripts.pull_db (copy the database into data/snapshot/) and stage 06 (publish).
# The "service_role" key can write to the whole database:
# never share it in chat, never commit it, never put it in the dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local model for the Auditor (see _config/models.md)
OLLAMA_URL=http://localhost:11434
MODELO_AUDITOR=gemma4:e4b-it-qat

# Auditor gateway (api/). On the Auditor's PC: API_KEY, CORS_ORIGINS (optional, comma-separated). Start it with --host <its Wi-Fi/LAN address>.
# On the Calculator's and Chatbot's PCs: AUDITOR_URL and AUDITOR_API_KEY (the same value as the gateway's API_KEY).
API_KEY=<long random key; generate one on the Auditor PC; never commit it>
CORS_ORIGINS=
AUDITOR_URL=http://192.168.1.128:8000
AUDITOR_API_KEY=<the gateway API_KEY, from the Auditor owner; never commit it>
