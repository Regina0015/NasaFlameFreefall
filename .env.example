# Copy to .env and fill in. .env is never committed.
# SUPABASE_*: only needed by whoever runs stage 06 (publish).
# The "service_role" key can write to the whole database:
# never share it in chat, never commit it, never put it in the dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auditor command, run by scripts/audit_step.py as a list of arguments (no shell)
# with the finding path added as the last argument. It must write its verdict to
# <finding dir>/F-001.v<N>.audit.json. Left empty, every finding is "pending audit".
# Quote paths with spaces. The command for scripts/auditar.py is still being agreed
# with its owner: its options and output folder differ from this contract.
AUDITOR_CMD=

# Local model for the Auditor (see _config/models.md)
OLLAMA_URL=http://localhost:11434
MODELO_AUDITOR=gemma4:e4b-it-qat
